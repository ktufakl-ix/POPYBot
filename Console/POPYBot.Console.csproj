<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>POPYBot.Console</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\POPYBot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyPlugins" AfterTargets="Build">
    <MakeDir Directories="$(OutputPath)plugins" Condition="!Exists('$(OutputPath)plugins')" />
    <ItemGroup>
      <SamplePluginFiles Include="..\Plugins\SamplePlugin\bin\$(Configuration)\net10.0\SamplePlugin.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SamplePluginFiles)" DestinationFolder="$(OutputPath)plugins" Condition="Exists('%(FullPath)')" SkipUnchangedFiles="true" />
    <Message Text="[POPYBot] Plugin DLLs copied to $(OutputPath)plugins" Importance="low" />
  </Target>

</Project>
